{
  "name": "@jkay/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/db/migrate.js && node --env-file-if-exists=../../.env dist/db/seed.js && node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=../../.env src/db/seed.ts",
    "test": "tsx --test test/*.test.ts",
    "start:server-only": "node --env-file-if-exists=../../.env dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^8.0.2",
    "@jkay/shared": "0.1.0",
    "drizzle-orm": "^0.36.0",
    "fastify": "^5.1.0",
    "pg-boss": "^10.1.5",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
