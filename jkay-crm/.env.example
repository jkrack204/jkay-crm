# Copy this file to .env and fill in the values. Never commit .env.
# On Railway these are set in the service's Variables tab (reference the
# Postgres and Bucket services so the values fill in automatically).

# --- Database (Railway Postgres) -------------------------------------------
# Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:password@localhost:5432/jkay_crm

# --- File storage (Railway Storage Bucket, S3-compatible) -------------------
# Railway: reference the bucket's own variables, e.g. for a bucket named "files":
#   BUCKET_ENDPOINT=${{files.ENDPOINT}}   BUCKET_NAME=${{files.BUCKET}}
#   BUCKET_ACCESS_KEY_ID=${{files.ACCESS_KEY_ID}}
#   BUCKET_SECRET_ACCESS_KEY=${{files.SECRET_ACCESS_KEY}}   BUCKET_REGION=${{files.REGION}}
BUCKET_ENDPOINT=
BUCKET_NAME=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_REGION=us-east-1
# Only if the bucket's Credentials tab says to use path-style URLs:
BUCKET_PATH_STYLE=false
# Local development without a bucket: keep uploads in this folder instead.
STORAGE_LOCAL_DIR=./.uploads

# --- App --------------------------------------------------------------------
PORT=3000
# Long random string. Signs nothing yet, but is the key that encrypts the
# lead-source API keys stored in the database. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEY=
# Set to "true" behind HTTPS (Railway) so session cookies are Secure.
COOKIE_SECURE=false

# --- Alert emails (Resend) --------------------------------------------------
# Nothing is emailed while RESEND_API_KEY is empty. EMAIL_FROM must be on a domain
# verified in Resend. APP_URL is the CRM's web address, linked from the emails.
EMAIL_FROM=JK Racks CRM <alerts@jkayracks.in>
RESEND_API_KEY=
APP_URL=

# --- Background jobs ---------------------------------------------------------
# Reminders, alert emails and the nightly backup run inside the app every minute.
# Set to false to run a copy of the app without them (they're safe to run twice anyway).
JOBS_ENABLED=true
# How many days of nightly backups to keep in the bucket.
BACKUP_KEEP_DAYS=30

# --- Demo data -----------------------------------------------------------------
# "true" shows Admin › Settings › Demo data (load / remove sample data, erase all leads).
# Turn it on only for a demo; delete it before real use.
DEMO_DATA=false
