# Copy this file to .env and fill in the values. Never commit .env.
# On Railway these are set in the service's Variables tab (reference the
# Postgres and Bucket services so the values fill in automatically).

# --- Database (Railway Postgres) -------------------------------------------
# Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:password@localhost:5432/jkay_crm

# --- File storage (Railway Storage Bucket, S3-compatible) -------------------
# Railway: copy from the bucket's Credentials tab / reference its variables
BUCKET_ENDPOINT=
BUCKET_NAME=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_REGION=us-east-1

# --- App --------------------------------------------------------------------
PORT=3000
# Long random string. Signs nothing yet, but is the key that encrypts the
# lead-source API keys stored in the database. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEY=
# Set to "true" behind HTTPS (Railway) so session cookies are Secure.
COOKIE_SECURE=false

# --- Email (alerts) ---------------------------------------------------------
EMAIL_FROM=JKAY CRM <alerts@jkayracks.in>
RESEND_API_KEY=
